<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.uskoag</groupId>
        <artifactId>uskoag-wallet-parent</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>uskoag-wallet-ui</artifactId>
    <packaging>jar</packaging>

    <description>uskoag-wallet.exe — the wallet itself. JavaFX, tray-resident, and the only process
        that ever holds a refresh token. Embeds the daemon in-process rather than talking to it, because
        an approval dialog that cannot be shown is an approval that cannot be given.</description>

    <properties>
        <mainClass>uskoag.wallet.ui.Main</mainClass>
        <!-- JavaFX ships prebuilt native bundles per OS/arch on Maven Central; the classifier picks
             which one gets shaded in. Override with -Djavafx.classifier=mac-aarch64 (or mac, linux,
             linux-aarch64) to build for a different target — Maven just downloads the artifact, so
             this works from any build machine regardless of its own OS. -->
        <javafx.classifier>win</javafx.classifier>
        <!-- AOT off on a Mac (-Dwallet.aot=false): the second start of a JavaFX app with AOT dies in AOTLinkedClassBulkLoader on JDK 25.0.4.1, Apple silicon. Stopgap; cause in cdpai PRP 21. -->
        <wallet.aot>true</wallet.aot>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.uskoag</groupId>
            <artifactId>uskoag-wallet-daemon</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.luvml</groupId>
            <artifactId>luvjfx</artifactId>
            <version>${luvjfx.ver}</version>
        </dependency>

        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-frame</artifactId>
            <version>0.3-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-tray</artifactId>
            <version>0.3-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-ui</artifactId>
            <version>0.3-SNAPSHOT</version>
        </dependency>

        <!-- The classifier carries the natives as well as the classes; the plain artifact alone
             cannot run from a shaded jar. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>

        <!-- Test only, and only for SwingFXUtils: ApprovalPreview renders every shape of the approval
             dialog to a PNG so its size and contrast can be checked by looking rather than by asking
             somebody to trigger a real approval. Nothing in the app touches Swing. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.ver}</version>
            <classifier>${javafx.classifier}</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${mainClass}</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <finalName>uskoag-wallet</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The cmdtools launcher(s), built by jr-maven-plugin with the config baked in (replaces the .jrc):
         mvn -Djrexe -Djr.installDir=<folder on PATH> package -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation>
                <property>
                    <name>jrexe</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.3.0</version>
                        <executions>
                            <execution>
                                <id>uskoag-wallet</id>
                                <goals><goal>exe</goal></goals>
                                <configuration>
                                    <name>uskoag-wallet</name>
                                    <jar>${project.build.directory}/uskoag-wallet.jar</jar>
                                    <jvmMode>dll</jvmMode>
                                    <aot>${wallet.aot}</aot>
                                    <!-- Memory (PRP 08): embeds ArcadeDB, so G1, always with its three caps; plain G1 on a 16-core
                                         machine commits ~59 MB of its own bookkeeping. -Xmx leaves room for a Drive transfer in flight.
                                         No G1PeriodicGC: the idle trim (Wallet.start) gives memory back once per idle stretch. -->
                                    <vmArgs><vmArg>-Xms16m</vmArg><vmArg>-Xmx512m</vmArg><vmArg>-Xss512k</vmArg><vmArg>-XX:+UseG1GC</vmArg><vmArg>-XX:ParallelGCThreads=2</vmArg><vmArg>-XX:ConcGCThreads=1</vmArg><vmArg>-XX:MarkStackSize=64K</vmArg><vmArg>-XX:MinHeapFreeRatio=10</vmArg><vmArg>-XX:MaxHeapFreeRatio=30</vmArg><vmArg>-XX:TieredStopAtLevel=1</vmArg><vmArg>-XX:MaxMetaspaceSize=128m</vmArg><vmArg>-XX:ReservedCodeCacheSize=48m</vmArg><vmArg>--enable-native-access=ALL-UNNAMED</vmArg><vmArg>-Dfile.encoding=UTF-8</vmArg></vmArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
